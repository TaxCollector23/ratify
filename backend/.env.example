# Postgres (primary relational store)
DATABASE_URL=postgres://ratify:ratify@localhost:5432/ratify

# Redis (BullMQ queues, caching, rate limiting)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (snapshots, diffs, parsed artifacts, LLM payloads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ratify-artifacts
S3_ACCESS_KEY_ID=ratify
S3_SECRET_ACCESS_KEY=ratify-secret

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# LLM reasoning: "mock" (deterministic fixture responses, no external calls) or "anthropic"
RATIFY_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
RATIFY_APP_URL=http://localhost:4000
REPO_SYNC_WORKDIR=/tmp/ratify-repos
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Observability (optional; omit to disable tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=
